# Environment Variables for n8n TELOSCRIPT Docker Setup
# Copy this file to .env and configure your values

# =============================================================================
# TELOSCRIPT Configuration
# =============================================================================

# Required: OpenAI API key for TELOSCRIPT agent operations
OPENAI_API_KEY=sk-your-openai-api-key-here

# TELOSCRIPT connection settings
TELOSCRIPT_BASE_URL=http://teloscript:8000
TELOSCRIPT_HOST=0.0.0.0
TELOSCRIPT_PORT=8000

# =============================================================================
# n8n Configuration  
# =============================================================================

# Basic Authentication (set to true for production)
N8N_BASIC_AUTH_ACTIVE=false
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=your-secure-password-here

# n8n Host and Port
N8N_HOST=0.0.0.0
N8N_PORT=5678

# Protocol and webhook URL (update for production)
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# Community Packages
N8N_COMMUNITY_PACKAGES_ENABLED=true

# Log Level (debug, info, warn, error)
N8N_LOG_LEVEL=info

# Timezone
GENERIC_TIMEZONE=America/New_York

# =============================================================================
# Database Configuration (Optional - for production)
# =============================================================================

# Database type (sqlite, postgresdb, mysqldb)
DB_TYPE=sqlite

# PostgreSQL settings (if using postgres)
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=your-db-password-here

# =============================================================================
# Security Settings (Production)
# =============================================================================

# Encryption key for credentials (generate a random 32-character string)
N8N_ENCRYPTION_KEY=your-32-character-encryption-key

# JWT secret
N8N_USER_MANAGEMENT_JWT_SECRET=your-jwt-secret-here

# Secure cookies (set to true with HTTPS)
N8N_SECURE_COOKIE=false

# =============================================================================
# MCP Server API Keys (for advanced TELOSCRIPT functionality)
# =============================================================================

# Brave Search API
BRAVE_API_KEY=your-brave-search-api-key

# GitHub Personal Access Token
GITHUB_PERSONAL_ACCESS_TOKEN=your-github-token

# Tavily API Key
TAVILY_API_KEY=your-tavily-api-key

# =============================================================================
# Development Settings
# =============================================================================

# Node environment
NODE_ENV=development

# Enable debug logs
DEBUG=false

# Disable telemetry (optional)
N8N_DIAGNOSTICS_ENABLED=false

# =============================================================================
# Docker Compose Override Settings
# =============================================================================

# Container names prefix (optional)
COMPOSE_PROJECT_NAME=teloscript-n8n

# Volume paths (if you want to customize)
N8N_DATA_PATH=./n8n-data
TELOSCRIPT_DATA_PATH=./teloscript-data
TELOSCRIPT_CONFIG_PATH=./config

# =============================================================================
# Production Additional Settings
# =============================================================================

# Max payload size (for large files)
N8N_PAYLOAD_SIZE_MAX=16

# Max execution timeout (in seconds)
EXECUTIONS_TIMEOUT=3600

# Max executions history to keep
EXECUTIONS_DATA_MAX_AGE=720

# Queue mode (for scaling)
EXECUTIONS_MODE=regular

# =============================================================================
# Monitoring and Logging (Production)
# =============================================================================

# Log file settings
N8N_LOG_FILE_COUNT_MAX=100
N8N_LOG_FILE_SIZE_MAX=16

# Metrics
N8N_METRICS=false
N8N_METRICS_PREFIX=n8n_

# =============================================================================
# Usage Notes:
# =============================================================================
#
# Quick Start:
# 1. Copy this file: cp .env.example .env
# 2. Add your OpenAI API key
# 3. Run: docker-compose up -d
#
# Production Setup:
# 1. Set N8N_BASIC_AUTH_ACTIVE=true
# 2. Use strong passwords and encryption keys
# 3. Configure HTTPS with N8N_PROTOCOL=https
# 4. Set up external database (postgres recommended)
# 5. Add monitoring and backup strategies
#
# Development:
# - Use N8N_LOG_LEVEL=debug for detailed logs
# - Set DEBUG=true for TELOSCRIPT debugging
# - Mount local dist folder for package development
#
# =============================================================================